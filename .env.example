# ---- Mercury environment ----------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.

# Rail mode: "fixture" (offline, deterministic, default) or "live" (real Razorpay test keys)
RAIL_MODE=fixture

# Razorpay TEST MODE ONLY. Required when RAIL_MODE=live.
# Get these from https://dashboard.razorpay.com (Test Mode -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Anthropic API key. Required from M4 (agent negotiation).
ANTHROPIC_API_KEY=

# Model configuration
MERCURY_MODEL=claude-opus-5
MERCURY_EFFORT=high

# Database
MERCURY_DB=./mercury.db
